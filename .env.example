# Copy file này thành .env và điền giá trị thật, KHÔNG commit file .env lên git

# Domain/IP public mà thiết bị ESP32 sẽ gọi thẳng vào để tải audio stream.
# Dùng IP tạm thời lúc test, nên đổi sang domain HTTPS khi dùng thật.
PUBLIC_BASE_URL=http://your-vps-ip-or-domain:8000

# API key của YouTube Data API v3 (console.cloud.google.com -> Credentials
# -> Create Credentials -> API key). Để trống thì tự fallback sang yt-dlp
# scrape HTML (chậm hơn nhiều, ~45s thay vì <1s cho mỗi lần search).
YOUTUBE_API_KEY=

LOG_LEVEL=INFO
CACHE_DIR=/app/cache
